# WhatsApp assistant (api/whatsapp.js). Copy these names into
# Vercel -> Project -> Settings -> Environment Variables.
# NEVER put real values in this file or commit a real .env.

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Any long random string you choose; paste the same one into Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=

# Meta for Developers -> your app -> App settings -> Basic -> App secret
WHATSAPP_APP_SECRET=

# Meta for Developers -> WhatsApp -> API Setup (use a permanent System User token for production)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# WHATSAPP_GRAPH_VERSION=v23.0
